# Copy this file to .env and fill in your keys. .env is git-ignored.

# Required for the live agents (risk_agent.py / change_agent.py). Get one at
# https://platform.claude.com — billed by token; a full run costs a few cents.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — override the model the agents use (defaults to claude-sonnet-5).
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Live Jira (optional) ------------------------------------------------------
# Set JIRA_LIVE=1 to make Flow 1 read defects straight from Jira via REST+JQL
# instead of data/jira_export.csv. Also used by the seed/ scripts.
# Atlassian API token: https://id.atlassian.com/manage/api-tokens
# JIRA_LIVE=1
# ATLASSIAN_SITE=your-site.atlassian.net
# ATLASSIAN_EMAIL=you@example.com
# ATLASSIAN_TOKEN=ATATT...
# JIRA_PROJECT_KEY=KAN
# JIRA_JQL=project = KAN AND labels = defect-history ORDER BY resolved DESC

# --- Live release delta for Flow 2 (optional) ----------------------------------
# Set CHANGE_LIVE=1 to make Flow 2 read its release delta live: features & bug
# fixes from Jira (labels release-delta + feature/bugfix) and requirement changes
# from the Confluence page below. Churn always stays a CSV (it's git history).
# Reuses ATLASSIAN_SITE/EMAIL/TOKEN and JIRA_PROJECT_KEY above.
# CHANGE_LIVE=1
# CONFLUENCE_PAGE_ID=1572866
# --- or look the page up by name instead of id: ---
# CONFLUENCE_SPACE_KEY=PM
# CONFLUENCE_PAGE_TITLE=Risk-Based Regression POC — Release Requirements & Overview
# Optional custom queries:
# JIRA_FEATURE_JQL=project = KAN AND labels = "release-delta" AND labels = "feature"
# JIRA_BUGFIX_JQL=project = KAN AND labels = "release-delta" AND labels = "bugfix"
