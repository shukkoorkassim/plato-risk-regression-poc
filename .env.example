# =============================================================================
# .env.example — every setting the agent reads, in one place.
#
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (macOS / Linux)
#
# Then uncomment and fill in only what you need. `.env` is git-ignored.
# Everything here is OPTIONAL except ANTHROPIC_API_KEY, and that is only
# needed for the two commands that call the LLM (--flow, --demo).
#
# Every setting can also be given as a shell environment variable; the shell
# wins over .env. Booleans accept: 1 / true / yes / on.
#
# Verify your setup at any time with:  python run_poc.py --selftest
# =============================================================================


# -----------------------------------------------------------------------------
# 1. LLM — needed only for the live agent runs
# -----------------------------------------------------------------------------
# Used by:  python run_poc.py --flow 1 | --flow 2 | --flow both | --demo
# Not used by: --dry-run, --showcase, --report, --benchmark, --selftest
# Get a key at https://platform.claude.com — billed per token; a full run of
# one flow costs a few cents.
ANTHROPIC_API_KEY=sk-ant-...

# Override the model. Default: claude-sonnet-5
# ANTHROPIC_MODEL=claude-sonnet-5


# -----------------------------------------------------------------------------
# 2. Selection tuning
# -----------------------------------------------------------------------------
# The cut-off a component's score must reach for its tests to be selected.
# Applies to BOTH Flow 1 risk and Flow 2 impact. Default: 4.0
# Lower  = more tests run, fewer misses, less time saved.
# Higher = fewer tests run, more time saved, more risk of a miss.
# Also settable per-run:  python run_poc.py --threshold 3.0 --report
# RISK_THRESHOLD=4.0


# -----------------------------------------------------------------------------
# 3. Live Jira — Flow 1 defect history
# -----------------------------------------------------------------------------
# With JIRA_LIVE unset, Flow 1 reads data/jira_export.csv.
# With JIRA_LIVE=1 AND the three ATLASSIAN_* values present, it reads resolved
# defects straight from Jira over REST. If the credentials are missing it falls
# back to the CSV rather than failing.
# API token: https://id.atlassian.com/manage/api-tokens
# JIRA_LIVE=1
# ATLASSIAN_SITE=your-site.atlassian.net
# ATLASSIAN_EMAIL=you@example.com
# ATLASSIAN_TOKEN=ATATT...

# Project key used by every Jira query and by defect filing. Default: KAN
# JIRA_PROJECT_KEY=KAN

# The query Flow 1 uses. Default targets this POC's seeded issues:
#   project = <JIRA_PROJECT_KEY> AND labels = defect-history ORDER BY resolved DESC
# For a REAL project, use the resolved-bugs basis instead:
#   JIRA_JQL=issuetype = Bug AND statusCategory = Done AND resolved >= -180d
# JIRA_JQL=

# Component and severity are read from the issue's Components and Priority
# fields; where those are empty (common in team-managed projects) the agent
# falls back to the issue's labels.


# -----------------------------------------------------------------------------
# 4. Live Jira + Confluence — Flow 2 release delta
# -----------------------------------------------------------------------------
# With CHANGE_LIVE unset, Flow 2 reads the CSVs in data/release_delta/.
# With CHANGE_LIVE=1 it reads: features and bug fixes from Jira, requirement
# changes from a Confluence page. Code churn ALWAYS stays a CSV — it comes from
# git history, not a tracker. Each source falls back to its CSV independently.
# Reuses the ATLASSIAN_* values above.
# CHANGE_LIVE=1

# The Confluence page holding the requirement table. Give the page id, OR the
# space key + exact title. Any table row keyed REQ-### is picked up.
# CONFLUENCE_PAGE_ID=1572866
# CONFLUENCE_SPACE_KEY=PM
# CONFLUENCE_PAGE_TITLE=Release 4.2 - Requirement Changes

# Override the two release-delta queries. Defaults:
#   project = <KEY> AND labels = "release-delta" AND labels = "feature" ORDER BY created ASC
#   project = <KEY> AND labels = "release-delta" AND labels = "bugfix"  ORDER BY created ASC
# JIRA_FEATURE_JQL=
# JIRA_BUGFIX_JQL=


# -----------------------------------------------------------------------------
# 5. Defect filing — what the agent does when it finds a REAL app bug
# -----------------------------------------------------------------------------
# REPORT_BUGS=1 lets the agent create a real Jira issue. Unset or 0 = rehearse
# without creating any ticket. Needs the ATLASSIAN_* credentials above.
# Use 0 when practising a demo so you do not file a ticket on every run.
# REPORT_BUGS=1

# Issue type to create. Default: Task
# (Many team-managed projects have no "Bug" type; Task always exists.)
# JIRA_DEFECT_ISSUETYPE=Task
# JIRA_BUG_ISSUETYPE=Task          # legacy alias, read if the above is unset

# Who to assign filed defects to. Default: ATLASSIAN_EMAIL
# JIRA_ASSIGNEE_EMAIL=dev-lead@example.com


# -----------------------------------------------------------------------------
# 6. Governance — approval gates and how test fixes are delivered
# -----------------------------------------------------------------------------
# Four human gates exist: data quality, risk ratings, defect assignment,
# test-fix merge. Unset, each one BLOCKS and prints what it is waiting for.
# APPROVE_ALL=1 auto-approves all four — use it for an uninterrupted demo, and
# leave it unset when you want to show the gates actually stopping the agent.
# APPROVE_ALL=1

# How an auto test-fix is delivered. Unset: the proposed file is written to
# _proposed_fixes/ for review. PR_MODE=1 with git (and gh) on PATH: a real
# branch and pull request is opened instead. The agent NEVER writes to main,
# and NEVER edits application source to hide a failure, in either mode.
# PR_MODE=1
